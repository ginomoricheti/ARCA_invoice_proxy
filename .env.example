# Server
PORT=8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arca_proxy?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ARCA Configuration
ARCA_ENVIRONMENT=homologation
ARCA_WSAA_URL=https://wsaa.homo.afip.gov.ar/ws/services/LoginCms
ARCA_WSFE_URL=https://servicios1.afip.gov.ar/wsfev1/service.asmx
ARCA_CERT_PATH=
ARCA_KEY_PATH=

# Authentication
API_KEY_PEPPER=change-me-in-production-use-a-secure-random-string
IDEMPOTENCY_TTL=24h

# Logging
LOG_LEVEL=info
LOG_FORMAT=json